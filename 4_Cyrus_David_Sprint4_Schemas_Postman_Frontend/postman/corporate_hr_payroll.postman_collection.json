    {
      "name": "3. Daily Attendance Tracking",
      "item": [
        {
          "name": "POST /api/attendance/clockin (Sample from PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var res = pm.response.json();",
                  "pm.test('Response matches PDF structure', function () { pm.expect(res.success).to.be.true; pm.expect(res.message).to.eql('Record created successfully'); pm.expect(res.data).to.have.property('_id'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{testEmployeeId}}\",\n  \"date\": \"2026-09-01T10:00:00Z\",\n  \"clockIn\": \"09:00:00\",\n  \"status\": \"Present\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/attendance/clockin", "host": ["{{baseUrl}}"], "path": ["attendance", "clockin"] }
          }
        },
        {
          "name": "Duplicate Clock-in (Business Rule Conflict 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "var res = pm.response.json();",
                  "pm.test('Error response contains VALIDATION_ERROR', function () { pm.expect(res.success).to.be.false; pm.expect(res.errorCode).to.eql('VALIDATION_ERROR'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{testEmployeeId}}\",\n  \"date\": \"2026-09-01T10:00:00Z\",\n  \"clockIn\": \"09:05:00\",\n  \"status\": \"Present\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/attendance/clockin", "host": ["{{baseUrl}}"], "path": ["attendance", "clockin"] }
          }
        },
        {
          "name": "POST /api/attendance/clockout (Clock-out)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{testEmployeeId}}\",\n  \"date\": \"2026-09-01\",\n  \"clockOut\": \"17:30:00\"\n}"
